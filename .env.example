# Copiar a .env para correr en local. En EasyPanel estas van como variables
# de entorno del servicio, nunca horneadas en la imagen.

# ------------------------------------------------------------- obligatorias
# Sin alguna de estas tres, el servicio no arranca (ver infrastructure/config.py).

# URL interna del backend de cEats, dentro de la red de Docker.
CEATS_BACKEND_URL=http://ceatsv2-backend:3000

# La llave con la que ESTE servicio se identifica al backend
# (Authorization: Bearer <INTEL_SERVICE_KEY>) al pedir /api/internal/intel/*.
INTEL_SERVICE_KEY=

# La llave que ESTE servicio exige a quien lo llame (cabecera X-Intel-Key).
# La usa el backend de cEats para hablarle a /v1/recomendaciones.
INTEL_INBOUND_KEY=

# IMPORTANTE: INTEL_SERVICE_KEY e INTEL_INBOUND_KEY deben ser distintas entre
# si, y ambas distintas de API_SECRET_KEY del backend. Generarlas con 32 bytes
# aleatorios cada una, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ----------------------------------------------------------------- opcionales
# Tienen valor por defecto; solo hace falta tocarlas para ajustar comportamiento.

# Segundos que vive una entrada de la cache de historial de ventas.
CACHE_TTL_SEGUNDOS=300

# Timeout del cliente HTTP contra el backend, en segundos. El backend espera
# como maximo 2000ms por este servicio (ver CONTRATO_INTEL.md); no subir esto
# por encima de eso sin coordinar con ese lado.
HTTP_TIMEOUT_SEGUNDOS=2

# Tope de pasos de reduccion del interprete de calculo lambda antes de
# declarar que un termino no llega a forma normal.
MAX_PASOS_LAMBDA=10000

# Ventana de historial que usa la cascada de recomendaciones (nivel 1 y 2).
VENTANA_DIAS=90

# Ventana larga para el escalon 3 de la cascada, cuando la ventana corta no
# junta suficiente co-ocurrencia.
VENTANA_LARGA_DIAS=365
